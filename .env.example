# Minicoder workshop configuration — copy this file to `.env` in this same
# folder (`minicoder/.env`) and fill in your own values. Never commit `.env`.
#
# This single .env governs all three steps:
#   step01 -> local Ollama
#   step02 -> OpenRouter (cloud)
#   step03 -> OpenRouter (cloud)

# --- step01: local Ollama ---------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_API_KEY=

# --- step02 & step03: OpenRouter (cloud) ------------------------------------
# Create an account and generate a key at https://openrouter.ai/keys
# OPENROUTER_MODEL must be the exact model slug shown on
# https://openrouter.ai/models (e.g. a DeepSeek model id).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
